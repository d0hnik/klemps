# Runtime (shell variables; .env is NOT loaded automatically)
HOST=127.0.0.1
PORT=3000
RUST_LOG=info

# CORS: exact, comma-separated HTTP(S) browser origins, no wildcard/paths
CORS_ALLOWED_ORIGINS=http://localhost:5173

# In-memory sliding-window limit shared by workers in one API process.
# Applies to /api/v1 routes, not /api/health.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Cargo build-time configuration
KLEMPS_FRONTEND_DIR=../client
# Set to 1 for backend-only CI/container builds
KLEMPS_SKIP_TS_GENERATION=0
