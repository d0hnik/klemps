# Runtime settings (use your shell/environment to supply these; .env is not automatically loaded)
HOST=127.0.0.1
PORT=3000
RUST_LOG=info

# Cargo build-time settings (optional)
# Relative paths are resolved from server/Cargo.toml
KLEMPS_FRONTEND_DIR=../client
# Set to 1 only for API-only/CI/container builds without a frontend checkout
KLEMPS_SKIP_TS_GENERATION=0
